{
  "name": "elias-painting-local-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "prepare:media": "node scripts/prepare-media.mjs",
    "build": "npm run prepare:media && tsc -b && vite build --configLoader runner && vite build --configLoader runner --ssr src/entry-server.tsx --outDir .ssr && node scripts/build-static-fallback.mjs",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 4173",
    "test": "node tests/gallery.test.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "predev": "npm run prepare:media"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
